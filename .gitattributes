# Normalize text files to LF in the repo and in working copies, on every OS.
* text=auto eol=lf

# Windows scripts need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.mp4 binary
*.jar binary
*.apk binary
*.aab binary
*.keystore binary
*.jks binary
