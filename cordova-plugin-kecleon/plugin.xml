<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0"
        xmlns:android="http://schemas.android.com/apk/res/android"
        id="cordova-plugin-kecleon"
        version="0.1.0">

    <name>Kecleon</name>
    <description>Prevent and detect screenshots and screen recording on Android.</description>
    <license>MIT</license>
    <keywords>screenshot,screen recording,FLAG_SECURE,privacy</keywords>

    <engines>
        <engine name="cordova" version=">=12.0.0" />
        <engine name="cordova-android" version=">=14.0.0" />
    </engines>

    <js-module src="www/kecleon.js" name="Kecleon">
        <clobbers target="Kecleon" />
    </js-module>

    <platform name="android">
        <config-file target="res/xml/config.xml" parent="/*">
            <feature name="Kecleon">
                <param name="android-package" value="dev.kecleon.Kecleon" />
                <param name="onload" value="true" />
            </feature>
            <preference name="GradlePluginKotlinEnabled" value="true" />
        </config-file>

        <!-- Normal (install-time) permissions; no runtime prompt. -->
        <config-file target="AndroidManifest.xml" parent="/manifest">
            <uses-permission android:name="android.permission.DETECT_SCREEN_CAPTURE" />
            <uses-permission android:name="android.permission.DETECT_SCREEN_RECORDING" />
        </config-file>

        <source-file src="src/android/Kecleon.kt" target-dir="app/src/main/kotlin/dev/kecleon" />
    </platform>
</plugin>
